# ~/.local/share/chezmoi/homebrew/Brewfile
# Core formulae — the terminal + editor environment. Installs WITHOUT admin
# once Homebrew itself is present. Apply with:
#   brew bundle --file="$HOME/.local/share/chezmoi/homebrew/Brewfile"
#
# GUI apps live in Brewfile.casks (some need admin/MDM) — see that file.

## Core dev tools ####################################################
brew "git"                     # Distributed revision control system
brew "gh"                      # GitHub command-line tool
brew "chezmoi"                 # Manage dotfiles across machines
brew "neovim"                  # Hyperextensible Vim-based editor
brew "tmux"                    # Terminal multiplexer
brew "starship"                # Cross-shell prompt
brew "mise"                    # Polyglot runtime version manager

## Modern CLI replacements ##########################################
brew "bat"                     # cat(1) clone with syntax highlighting
brew "eza"                     # Modern replacement for ls
brew "fd"                      # Simple, fast alternative to find
brew "ripgrep"                 # Fast grep alternative (rg)
brew "fzf"                     # Command-line fuzzy finder
brew "zoxide"                  # Smarter cd
brew "tree"                    # Display directories as trees
brew "watch"                   # Run a command periodically, fullscreen

## Shell enhancements ###############################################
brew "zsh-autosuggestions"     # Fish-like autosuggestions
brew "zsh-syntax-highlighting" # Fish-like syntax highlighting

## Dev workflow #####################################################
brew "awscli"                  # Amazon AWS command-line interface
brew "python@3.14"             # Python interpreter

## Fonts (install to ~/Library/Fonts — no admin) ####################
cask "font-sf-mono-nerd-font-ligaturized"
