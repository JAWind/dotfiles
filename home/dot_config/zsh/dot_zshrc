# ~/.config/zsh/.zshrc — interactive shell configuration

# ── Homebrew (first: puts brew tools on PATH) ───────────────────────
eval "$(/opt/homebrew/bin/brew shellenv)"
BREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"

# ── History ─────────────────────────────────────────────────────────
HISTFILE="$XDG_STATE_HOME/zsh/history"
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY          # share history between concurrent sessions
setopt HIST_IGNORE_ALL_DUPS   # remove older duplicate commands
setopt HIST_IGNORE_SPACE      # skip commands prefixed with a space
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY        # record timestamps

# ── Completion ──────────────────────────────────────────────────────
ZCOMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump"
[[ -d "${ZCOMPDUMP:h}" ]] || mkdir -p "${ZCOMPDUMP:h}"
autoload -Uz compinit && compinit -d "$ZCOMPDUMP"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive

# ── Secrets (pass) ──────────────────────────────────────────────────
export PASSWORD_STORE_DIR="$XDG_DATA_HOME/pass"

# ── Prompt & navigation tools ───────────────────────────────────────
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
eval "$(mise activate zsh)"

# fzf — modern integration (key bindings + fuzzy completion)
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# ── Aliases ─────────────────────────────────────────────────────────
alias ls="eza --group-directories-first"
alias ll="eza -lah --group-directories-first --git"
alias cat="bat"
alias find="fd"
alias grep="rg"

# ── Secrets from Keychain (safe/empty until you add them) ────────────
[[ -f "$ZDOTDIR/secrets.zsh" ]] && source "$ZDOTDIR/secrets.zsh"

# ── zsh plugins (syntax-highlighting MUST be sourced last) ──────────
source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" 2>/dev/null
source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" 2>/dev/null
