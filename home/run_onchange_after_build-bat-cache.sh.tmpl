#!/bin/sh
# Rebuild bat's theme cache so the Catppuccin theme is available.
# Re-runs whenever the theme file changes (hash below).
# theme hash: {{ include "dot_config/bat/themes/Catppuccin Mocha.tmTheme" | sha256sum }}
if command -v bat >/dev/null 2>&1; then
  bat cache --build >/dev/null 2>&1 || true
fi
