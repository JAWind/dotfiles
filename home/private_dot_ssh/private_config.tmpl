# ~/.ssh/config

Host *
    AddKeysToAgent yes
    UseKeychain yes
    IdentitiesOnly yes

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal

{{- if eq .chezmoi.hostname "work-laptop" }}

Host github-work
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_work
{{- end }}
